'use client';

import { PixelButton } from '@/components/pixel-button';
import { Panel } from '@/components/panel';

type Props = { error: Error & { digest?: string }; reset: () => void };

// {{ROUTE}} error boundary — plain technical voice. NPCs never deliver system failures.
export default function Error({ error, reset }: Props) {
  return (
    <main className="mx-auto flex max-w-xl flex-col gap-4 px-4 py-10">
      <Panel title="Error" tone="sunken">
        <p className="font-body text-body">Couldn&apos;t load {{THING}}. Try again in a moment.</p>
        {error.digest ? <p className="font-mono text-small text-ink-muted">Ref: {error.digest}</p> : null}
        <PixelButton variant="secondary" onClick={reset}>
          Retry
        </PixelButton>
      </Panel>
    </main>
  );
}
