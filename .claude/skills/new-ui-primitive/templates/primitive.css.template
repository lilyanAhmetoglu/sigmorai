/* {{NAME}}: <one line>. Defaults = variant "primary", size "md". Import it in app/globals.css. */
@layer components {
  .{{FILE}} {
    /* Token utilities only (app/styles/theme.css). Every size keeps a 44px hit area. */
    @apply inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center gap-2 px-4 py-2.5 font-display text-small font-bold uppercase select-none;
    @apply bg-accent text-text-on-accent shadow-notch inset-shadow-bevel;
    /* Press moves 2px (never scales) and swaps to the pressed bevel */
    @apply enabled:active:translate-x-0.5 enabled:active:translate-y-0.5 enabled:active:inset-shadow-bevel-pressed;
    @apply motion-safe:transition-transform motion-safe:duration-(--dur-1) motion-safe:ease-snap;
  }

  .{{FILE}}[data-variant='secondary'] { @apply bg-surface-3 text-text-1; }
  .{{FILE}
  /* The ghost keeps only its ring when pressed (no bevel) */
  .{{FILE}}[data-variant='ghost']:enabled:active {
    @apply inset-shadow-none;
  }}[data-variant='ghost'] {
    @apply bg-transparent text-text-1 shadow-none inset-shadow-none inset-ring-3 inset-ring-ink-500;
  }

  .{{FILE}}[data-size='sm'] { @apply px-3 py-1.5 text-hud; }
  .{{FILE}}[data-size='lg'] { @apply px-6 py-3.5 text-body-lg; }

  /* Last, so it beats the variant colours */
  .{{FILE}}:disabled { @apply cursor-not-allowed bg-ink-700 text-ink-400; }
}
