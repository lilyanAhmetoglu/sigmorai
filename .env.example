# Copy to .env.local (never committed). Server secrets stay WITHOUT the
# NEXT_PUBLIC_ prefix — that prefix inlines a value into the browser bundle.
# In production these live in Vercel → Project → Settings → Environment Variables.

# ── Public (safe in the browser) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (Neon) ──
DATABASE_URL=

# ── Auth.js v5 ──
AUTH_SECRET=                 # bunx auth secret
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=             # email magic link
AUTH_EMAIL_FROM=Sigmorai <hello@sigmorai.com>

# ── Code runner (E2B) ──
E2B_API_KEY=

# ── AI mentor + docs-sync drafts (Anthropic) ──
ANTHROPIC_API_KEY=

# ── Avatar uploads (Vercel Blob) ──
BLOB_READ_WRITE_TOKEN=

# ── Docs sync (opens new-level PRs) ──
GITHUB_TOKEN=
