# Copy to .env.local (never committed). Server secrets stay WITHOUT the
# NEXT_PUBLIC_ prefix — that prefix inlines a value into the browser bundle.
# In production these live in Vercel → Project → Settings → Environment Variables.

# ── Public (safe in the browser) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (Neon) ── `neon link` writes these for the linked branch
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# ── Auth (Clerk) ── `clerk init` writes these; dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Server-only. dashboard.clerk.com → Webhooks → the /api/webhooks/clerk endpoint
# (event: user.deleted) → Signing Secret. Without it the webhook answers 400.
CLERK_WEBHOOK_SIGNING_SECRET=

# ── AI mentor (Anthropic for now; planned to move to OpenAI later) ──
# Docs-watch and the knowledge-sync routine need no model key.
ANTHROPIC_API_KEY=

# ── Avatar uploads (Vercel Blob) ──
BLOB_READ_WRITE_TOKEN=

# ── Newsletter (Resend) ── server-only, never NEXT_PUBLIC_
# resend.com → API Keys: a key that can manage Contacts.
# RESEND_SEGMENT_ID = the id of the Segment new sign-ups join.
# Set the two vars only after the Vercel Firewall rate limit on POST /blog* exists
# (docs/plans/blog-newsletter-design-plan.md).
# Without both, the blog's newsletter box shows "Sign-up is not open yet."
RESEND_API_KEY=
RESEND_SEGMENT_ID=

# ── GitHub (optional, local only) ──
# Docs-watch runs in GitHub Actions with the built-in token; nothing to set here.
GITHUB_TOKEN=
